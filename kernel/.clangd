CompileFlags:
  Add: [
    -nostdinc,
    -m64,
    -D__KERNEL__,
    -D__GNUC__=11,
    -DKBUILD_MODNAME="shaper_mod",
    -DMODULE_LICENSE(x)=,
    -DMODULE_AUTHOR(x)=,
    -DMODULE_DESCRIPTION(x)=,
    -DMODULE_VERSION(x)=,
    -D__init=,
    -D__exit=,
    # Пути обновлены до 6.18.64-1-lts
    -include/usr/lib/modules/6.18.64-1-lts/build/include/linux/kconfig.h,
    -I/usr/lib/modules/6.18.64-1-lts/build/include,
    -I/usr/lib/modules/6.18.64-1-lts/build/include/uapi,
    -I/usr/lib/modules/6.18.64-1-lts/build/arch/x86/include,
    -I/usr/lib/modules/6.18.64-1-lts/build/arch/x86/include/uapi,
    -I/usr/lib/modules/6.18.64-1-lts/build/arch/x86/include/generated,
    -I/usr/lib/modules/6.18.64-1-lts/build/arch/x86/include/generated/uapi,
    -I/usr/lib/modules/6.18.64-1-lts/build/include/generated,
    # ВНИМАНИЕ: Если команда из Шага 1 выдала не 19, замените цифру ниже на вашу!
    -I/usr/lib/clang/19/include,
    -fno-ms-extensions
  ]
  Remove: [
    -mpreferred-stack-boundary=*,
    -mindirect-branch=*,
    -mindirect-branch-register,
    -fno-allow-store-data-races,
    -fzero-init-padding-bits=*,
    -fmin-function-alignment=*,
    -fconserve-stack,
    -mrecord-mcount
  ]
